<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentColor">#FF2F80ED</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#FF262626"/>
    <SolidColorBrush x:Key="CanvasBg" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="PanelBg" Color="#FF323232"/>
    <SolidColorBrush x:Key="PanelHeaderBg" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="PopupBg" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="InputBg" Color="#FF1F1F1F"/>
    <SolidColorBrush x:Key="LineBrush" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="HoverBg" Color="#FF434343"/>
    <SolidColorBrush x:Key="PressedBg" Color="#FF505050"/>
    <SolidColorBrush x:Key="SelectedBg" Color="#FF3A5578"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFDCDCDC"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DrawingBrush x:Key="CheckerSmall" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H2 V2 H0 Z"/>
                <GeometryDrawing Brush="#FFCCCCCC" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Icon helpers for the toolbox -->
    <Style x:Key="IconFill" TargetType="Path">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="IconStroke" TargetType="Path">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

    <Style x:Key="PanelHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Margin" Value="10,8,10,6"/>
    </Style>
    <Style x:Key="OptLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,6,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <Style x:Key="OptValue" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="MinWidth" Value="40"/>
    </Style>

</ResourceDictionary>
