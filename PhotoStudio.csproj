<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PhotoStudio</AssemblyName>
    <RootNamespace>PhotoStudio</RootNamespace>
    <Product>PhotoStudio</Product>
    <Version>1.0.0</Version>
    <Authors>Luca Pezzoli</Authors>
    <Company>Luca Pezzoli</Company>
    <Copyright>Copyright © 2026 Luca Pezzoli</Copyright>
    <Description>Photo editor with RAW development, culling and AI-assisted editing.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Assets\PhotoStudio.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- When publishing as a single file, bundle the native DLLs (LibRaw, ONNX Runtime) inside the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- The garbage collector compacts the memory of the large images more readily, instead of growing. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interface translations: the Italian text in the code is the key. -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="PhotoStudio.Localization.%(Filename).json" />
    <!-- YuNet face detector: tells the automatic light tools where the faces are. -->
    <EmbeddedResource Include="Assets\face_detection_yunet_2023mar.onnx" LogicalName="PhotoStudio.Assets.FaceDetector.onnx" />
    <!-- MediaPipe face landmarks: tells the culling whether the eyes are open. -->
    <EmbeddedResource Include="Assets\face_landmarks_mediapipe.onnx" LogicalName="PhotoStudio.Assets.FaceLandmarks.onnx" />
    <!-- Real-ESRGAN (small general model): the AI enlargement. -->
    <EmbeddedResource Include="Assets\realesr-general-x4v3.onnx" LogicalName="PhotoStudio.Assets.Upscaler.onnx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.50.0" />
    <!-- ONNX Runtime with DirectML: the AI networks run on any DirectX 12 graphics card, or on the processor. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" Version="0.21.1" />
  </ItemGroup>

  <!-- ONNX Runtime ships its C++ import libraries among the native files: they have no use next to the exe. -->
  <Target Name="DropImportLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

</Project>
