<Window x:Class="PhotoStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoStudio" Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= MENU ================= -->
        <Menu x:Name="MainMenu" Grid.Row="0" Padding="4,1">
            <MenuItem Header="_File" SubmenuOpened="Menu_SubmenuOpened">
                <MenuItem Header="Nuovo..." InputGestureText="Ctrl+N" Tag="file.new" Click="Menu_Click"/>
                <MenuItem Header="Apri..." InputGestureText="Ctrl+O" Tag="file.open" Click="Menu_Click"/>
                <MenuItem Header="Inserisci come livello..." InputGestureText="Shift+Ctrl+P" Tag="file.place" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Preselezione cartella..." InputGestureText="Alt+Ctrl+O" Tag="file.cull" Click="Menu_Click"/>
                <MenuItem Header="Salva e passa alla successiva" InputGestureText="Ctrl+Invio" Tag="batch.savenext" Click="Menu_Click"/>
                <MenuItem Header="Copia impostazioni di sviluppo" InputGestureText="Alt+Maiusc+C" Tag="dev.copy" Click="Menu_Click"/>
                <MenuItem Header="Applica impostazioni / preset..." InputGestureText="Alt+Maiusc+V" Tag="dev.paste" Click="Menu_Click"/>
                <MenuItem Header="Opzioni di esportazione..." Tag="batch.export" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Chiudi" InputGestureText="Ctrl+W" Tag="file.close" Click="Menu_Click"/>
                <MenuItem Header="Salva" InputGestureText="Ctrl+S" Tag="file.save" Click="Menu_Click"/>
                <MenuItem Header="Salva con nome..." InputGestureText="Shift+Ctrl+S" Tag="file.saveas" Click="Menu_Click"/>
                <MenuItem Header="Esporta come PNG..." InputGestureText="Alt+Shift+Ctrl+W" Tag="file.export" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Esci" InputGestureText="Ctrl+Q" Tag="file.exit" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="_Modifica" SubmenuOpened="Menu_SubmenuOpened">
                <MenuItem x:Name="UndoMenuItem" Header="Annulla" InputGestureText="Ctrl+Z" Tag="edit.undo" Click="Menu_Click"/>
                <MenuItem x:Name="RedoMenuItem" Header="Ripeti" InputGestureText="Shift+Ctrl+Z" Tag="edit.redo" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Taglia" InputGestureText="Ctrl+X" Tag="edit.cut" Click="Menu_Click"/>
                <MenuItem Header="Copia" InputGestureText="Ctrl+C" Tag="edit.copy" Click="Menu_Click"/>
                <MenuItem Header="Copia unita" InputGestureText="Shift+Ctrl+C" Tag="edit.copymerged" Click="Menu_Click"/>
                <MenuItem Header="Incolla" InputGestureText="Ctrl+V" Tag="edit.paste" Click="Menu_Click"/>
                <MenuItem Header="Cancella" InputGestureText="Canc" Tag="edit.clear" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Riempi con colore di primo piano" InputGestureText="Alt+Backspace" Tag="edit.fillfg" Click="Menu_Click"/>
                <MenuItem Header="Riempi con colore di sfondo" InputGestureText="Ctrl+Backspace" Tag="edit.fillbg" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Trasforma livello...">
                    <MenuItem Header="Scala / Ruota / Sposta..." InputGestureText="Ctrl+T" Tag="edit.transform" Click="Menu_Click"/>
                    <Separator/>
                    <MenuItem Header="Ruota di 180°" Tag="edit.layer180" Click="Menu_Click"/>
                    <MenuItem Header="Rifletti orizzontale" Tag="edit.layerfliph" Click="Menu_Click"/>
                    <MenuItem Header="Rifletti verticale" Tag="edit.layerflipv" Click="Menu_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Impostazioni AI (Gemini, Ollama, Claude)..." Tag="ai.settings" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="_Immagine" SubmenuOpened="Menu_SubmenuOpened">
                <MenuItem Header="Regolazioni">
                    <MenuItem Header="Luminosità/Contrasto..." Tag="adj.brightness" Click="Menu_Click"/>
                    <MenuItem Header="Livelli..." InputGestureText="Ctrl+L" Tag="adj.levels" Click="Menu_Click"/>
                    <MenuItem Header="Curve..." InputGestureText="Ctrl+M" Tag="adj.curves" Click="Menu_Click"/>
                    <MenuItem Header="Esposizione..." Tag="adj.exposure" Click="Menu_Click"/>
                    <Separator/>
                    <MenuItem Header="Vividezza..." Tag="adj.vibrance" Click="Menu_Click"/>
                    <MenuItem Header="Tonalità/Saturazione..." InputGestureText="Ctrl+U" Tag="adj.huesat" Click="Menu_Click"/>
                    <MenuItem Header="Bilanciamento colore..." InputGestureText="Ctrl+B" Tag="adj.colorbalance" Click="Menu_Click"/>
                    <MenuItem Header="Temperatura colore..." Tag="adj.temperature" Click="Menu_Click"/>
                    <MenuItem Header="Bianco e nero..." InputGestureText="Alt+Shift+Ctrl+B" Tag="adj.bw" Click="Menu_Click"/>
                    <Separator/>
                    <MenuItem Header="Inverti" InputGestureText="Ctrl+I" Tag="adj.invert" Click="Menu_Click"/>
                    <MenuItem Header="Posterizza..." Tag="adj.posterize" Click="Menu_Click"/>
                    <MenuItem Header="Soglia..." Tag="adj.threshold" Click="Menu_Click"/>
                    <Separator/>
                    <MenuItem Header="Ombre/Luci..." Tag="adj.shadows" Click="Menu_Click"/>
                    <MenuItem Header="Desatura" InputGestureText="Shift+Ctrl+U" Tag="adj.desaturate" Click="Menu_Click"/>
                    <MenuItem Header="Seppia" Tag="adj.sepia" Click="Menu_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="✨ Miglioramento automatico (Camera Raw)..." InputGestureText="Alt+Shift+Ctrl+A" Tag="adj.autoenhance" Click="Menu_Click"/>
                <MenuItem Header="☀ Luce intelligente..." InputGestureText="Alt+Ctrl+L" Tag="dev.smartlight" Click="Menu_Click"/>
                <MenuItem Header="◐ Maschere di luce (facile)..." InputGestureText="Alt+Ctrl+M" Tag="dev.masks" Click="Menu_Click"/>
                <MenuItem Header="Tono automatico" InputGestureText="Shift+Ctrl+L" Tag="adj.autotone" Click="Menu_Click"/>
                <MenuItem Header="Contrasto automatico" InputGestureText="Alt+Shift+Ctrl+L" Tag="adj.autocontrast" Click="Menu_Click"/>
                <MenuItem Header="Colore automatico" InputGestureText="Shift+Ctrl+B" Tag="adj.autocolor" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Dimensione immagine..." InputGestureText="Alt+Ctrl+I" Tag="img.resize" Click="Menu_Click"/>
                <MenuItem Header="Dimensione quadro..." InputGestureText="Alt+Ctrl+C" Tag="img.canvas" Click="Menu_Click"/>
                <MenuItem Header="Rotazione immagine">
                    <MenuItem Header="180°" Tag="img.rot180" Click="Menu_Click"/>
                    <MenuItem Header="90° in senso orario" Tag="img.rotcw" Click="Menu_Click"/>
                    <MenuItem Header="90° in senso antiorario" Tag="img.rotccw" Click="Menu_Click"/>
                    <Separator/>
                    <MenuItem Header="Rifletti quadro orizzontale" Tag="img.fliph" Click="Menu_Click"/>
                    <MenuItem Header="Rifletti quadro verticale" Tag="img.flipv" Click="Menu_Click"/>
                </MenuItem>
                <MenuItem Header="Ritaglia sulla selezione" Tag="img.cropsel" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Appiattisci immagine" Tag="layer.flatten" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="_Livello" SubmenuOpened="Menu_SubmenuOpened">
                <MenuItem Header="Nuovo livello" InputGestureText="Shift+Ctrl+N" Tag="layer.new" Click="Menu_Click"/>
                <MenuItem Header="Duplica livello / Livello tramite copia" InputGestureText="Ctrl+J" Tag="layer.duplicate" Click="Menu_Click"/>
                <MenuItem Header="Elimina livello" Tag="layer.delete" Click="Menu_Click"/>
                <MenuItem Header="Rinomina livello..." Tag="layer.rename" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Porta avanti" InputGestureText="Ctrl+]" Tag="layer.up" Click="Menu_Click"/>
                <MenuItem Header="Porta indietro" InputGestureText="Ctrl+[" Tag="layer.down" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Unisci sotto" InputGestureText="Ctrl+E" Tag="layer.merge" Click="Menu_Click"/>
                <MenuItem Header="Unisci visibili" InputGestureText="Shift+Ctrl+E" Tag="layer.mergevisible" Click="Menu_Click"/>
                <MenuItem Header="Appiattisci immagine" Tag="layer.flatten" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="_Selezione" SubmenuOpened="Menu_SubmenuOpened">
                <MenuItem Header="Tutto" InputGestureText="Ctrl+A" Tag="sel.all" Click="Menu_Click"/>
                <MenuItem Header="Deseleziona" InputGestureText="Ctrl+D" Tag="sel.none" Click="Menu_Click"/>
                <MenuItem Header="Inversa" InputGestureText="Shift+Ctrl+I" Tag="sel.invert" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Sfuma..." InputGestureText="Shift+F6" Tag="sel.feather" Click="Menu_Click"/>
            </MenuItem>
            <MenuItem Header="Fil_tro" SubmenuOpened="Menu_SubmenuOpened">
                <MenuItem Header="Filtro Camera Raw..." InputGestureText="Shift+Ctrl+A" Tag="flt.cameraraw" Click="Menu_Click"/>
                <MenuItem Header="✦ Modifica con AI..." InputGestureText="Shift+Ctrl+K" Tag="flt.ai" Click="Menu_Click"/>
                <Separator/>
                <MenuItem Header="Sfocatura">
                    <MenuItem Header="Controllo sfocatura gaussiana..." Tag="flt.gauss" Click="Menu_Click"/>
                    <MenuItem Header="Sfocatura movimento..." Tag="flt.motion" Click="Menu_Click"/>
                </MenuItem>
                <MenuItem Header="Contrasta">
                    <MenuItem Header="Contrasta" Tag="flt.sharpen" Click="Menu_Click"/>
                    <MenuItem Header="Maschera di contrasto..." Tag="flt.unsharp" Click="Menu_Click"/>
                    <MenuItem Header="Chiarezza..." Tag="flt.clarity" Click="Menu_Click"/>
                </MenuItem>
                <MenuItem Header="Disturbo">
                    <MenuItem Header="Aggiungi disturbo..." Tag="flt.noise" Click="Menu_Click"/>
                </MenuItem>
                <MenuItem Header="Effetto pixel">
                    <MenuItem Header="Mosaico..." Tag="flt.pixelate" Click="Menu_Click"/>
                </MenuItem>
                <MenuItem Header="Stilizzazione">
                    <MenuItem Header="Trova bordi" Tag="flt.edges" Click="Menu_Click"/>
                    <MenuItem Header="Rilievo..." Tag="flt.emboss" Click="Menu_Click"/>
                </MenuItem>
                <MenuItem Header="Rendering">
                    <MenuItem Header="Vignettatura..." Tag="flt.vignette" Click="Menu_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Visualizza" SubmenuOpened="Menu_SubmenuOpened">
                <MenuItem Header="Zoom avanti" InputGestureText="Ctrl++" Tag="view.zoomin" Click="Menu_Click"/>
                <MenuItem Header="Zoom indietro" InputGestureText="Ctrl+-" Tag="view.zoomout" Click="Menu_Click"/>
                <MenuItem Header="Adatta allo schermo" InputGestureText="Ctrl+0" Tag="view.fit" Click="Menu_Click"/>
                <MenuItem Header="Pixel effettivi (100%)" InputGestureText="Ctrl+1" Tag="view.actual" Click="Menu_Click"/>
                <Separator/>
                <MenuItem x:Name="LanguageMenu" Header="Lingua"/>
            </MenuItem>
            <MenuItem Header="_Aiuto">
                <MenuItem Header="Scorciatoie da tastiera" InputGestureText="F1" Tag="help.keys" Click="Menu_Click"/>
                <MenuItem Header="Informazioni su PhotoStudio" Tag="help.about" Click="Menu_Click"/>
            </MenuItem>
        </Menu>

        <!-- ================= OPTIONS BAR ================= -->
        <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,1" Height="38">
          <DockPanel>
            <Button x:Name="AutoEnhanceButton" DockPanel.Dock="Right" Margin="0,0,10,0" Padding="12,3" VerticalAlignment="Center"
                    Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Focusable="False"
                    Tag="adj.autoenhance" Click="OptAction_Click"
                    ToolTip="Come l'Automatico di Camera Raw: regola esposizione, contrasto, luci, ombre, bianchi, neri, vividezza e saturazione, con l'intensità che scegli.&#x0a;Con una selezione misura e corregge solo la zona selezionata (Alt+Shift+Ctrl+A)">
                <TextBlock Text="✨  Automatico" FontWeight="SemiBold" Foreground="White"/>
            </Button>
            <Button x:Name="SmartLightButton" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,3" VerticalAlignment="Center"
                    Background="#FFC88A1E" BorderBrush="#FFC88A1E" Focusable="False" Tag="dev.smartlight" Click="OptAction_Click"
                    ToolTip="Sistema la luce in un clic: esposizione e toni, poi maschere di luce dove servono (zone scure, luci, cielo, soggetto).&#x0a;Sulla foto aperta o su tutte le foto della cartella di modifica (Alt+Ctrl+L)">
                <TextBlock Text="☀  Luce intelligente" FontWeight="SemiBold" Foreground="White"/>
            </Button>
            <Button x:Name="LightMasksButton" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,3" VerticalAlignment="Center"
                    Focusable="False" Tag="dev.masks" Click="OptAction_Click"
                    ToolTip="Ritocca solo una parte della foto (ombre, luci, cielo, soggetto) con ricette pronte e comandi semplici (Alt+Ctrl+M)">
                <TextBlock Text="◐  Maschere di luce" FontWeight="SemiBold"/>
            </Button>
            <Button x:Name="CullButton" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,3" VerticalAlignment="Center"
                    Focusable="False" Tag="file.cull" Click="OptAction_Click"
                    ToolTip="Scorri tutte le foto di una cartella, elimina gli scarti con Canc e modifica le altre una alla volta (Alt+Ctrl+O)">
                <TextBlock Text="▦  Preselezione" FontWeight="SemiBold"/>
            </Button>
            <Button x:Name="AiButton" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,3" VerticalAlignment="Center"
                    Focusable="False" Tag="flt.ai" Click="OptAction_Click"
                    ToolTip="Descrivi a parole come vuoi la foto: l'AI (Gemini, Ollama o Claude) sceglie i valori dei cursori di Camera Raw, PhotoStudio elabora i pixel (Shift+Ctrl+K)">
                <TextBlock Text="✦  Modifica con AI" FontWeight="SemiBold"/>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                <TextBlock x:Name="ToolNameText" FontWeight="SemiBold" VerticalAlignment="Center" Width="150"/>
                <Border Width="1" Background="#FF484848" Margin="0,4,4,4"/>

                <StackPanel x:Name="OptBrush" Orientation="Horizontal">
                    <TextBlock Text="Dimensione:" Style="{StaticResource OptLabel}"/>
                    <Slider x:Name="BrushSize" Minimum="1" Maximum="500" Value="30" Width="120" ValueChanged="BrushSize_ValueChanged"/>
                    <TextBlock Style="{StaticResource OptValue}" Text="{Binding Value, ElementName=BrushSize, StringFormat={}{0:0} px}"/>
                    <TextBlock Text="Durezza:" Style="{StaticResource OptLabel}"/>
                    <Slider x:Name="BrushHardness" Minimum="0" Maximum="100" Value="80" Width="90"/>
                    <TextBlock Style="{StaticResource OptValue}" Text="{Binding Value, ElementName=BrushHardness, StringFormat={}{0:0}%}"/>
                    <TextBlock x:Name="BrushOpacityLabel" Text="Opacità:" Style="{StaticResource OptLabel}"/>
                    <Slider x:Name="BrushOpacity" Minimum="1" Maximum="100" Value="100" Width="90"/>
                    <TextBlock Style="{StaticResource OptValue}" Text="{Binding Value, ElementName=BrushOpacity, StringFormat={}{0:0}%}"/>
                    <ComboBox x:Name="DodgeMode" Width="100" SelectedIndex="0" Margin="12,0,0,0">
                        <ComboBoxItem Content="Scherma"/>
                        <ComboBoxItem Content="Brucia"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel x:Name="OptSelect" Orientation="Horizontal">
                    <Button Content="Tutto" Margin="12,0,0,0" Padding="10,2" Tag="sel.all" Click="OptAction_Click"/>
                    <Button Content="Deseleziona" Margin="6,0,0,0" Padding="10,2" Tag="sel.none" Click="OptAction_Click"/>
                    <Button Content="Inversa" Margin="6,0,0,0" Padding="10,2" Tag="sel.invert" Click="OptAction_Click"/>
                    <Button Content="Sfuma..." Margin="6,0,0,0" Padding="10,2" Tag="sel.feather" Click="OptAction_Click"/>
                </StackPanel>

                <StackPanel x:Name="OptTolerance" Orientation="Horizontal">
                    <TextBlock Text="Tolleranza:" Style="{StaticResource OptLabel}"/>
                    <Slider x:Name="Tolerance" Minimum="0" Maximum="255" Value="32" Width="110"/>
                    <TextBlock Style="{StaticResource OptValue}" Text="{Binding Value, ElementName=Tolerance, StringFormat={}{0:0}}"/>
                    <CheckBox x:Name="Contiguous" Content="Contigui" IsChecked="True" Margin="12,0,0,0"/>
                    <CheckBox x:Name="SampleAll" Content="Campiona tutti i livelli" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel x:Name="OptFillOpacity" Orientation="Horizontal">
                    <TextBlock Text="Opacità:" Style="{StaticResource OptLabel}"/>
                    <Slider x:Name="FillOpacity" Minimum="1" Maximum="100" Value="100" Width="90"/>
                    <TextBlock Style="{StaticResource OptValue}" Text="{Binding Value, ElementName=FillOpacity, StringFormat={}{0:0}%}"/>
                </StackPanel>

                <StackPanel x:Name="OptGradient" Orientation="Horizontal">
                    <TextBlock Text="Tipo:" Style="{StaticResource OptLabel}"/>
                    <ComboBox x:Name="GradientType" Width="100" SelectedIndex="0">
                        <ComboBoxItem Content="Lineare"/>
                        <ComboBoxItem Content="Radiale"/>
                    </ComboBox>
                    <TextBlock Text="Colori:" Style="{StaticResource OptLabel}"/>
                    <ComboBox x:Name="GradientColors" Width="200" SelectedIndex="0">
                        <ComboBoxItem Content="Primo piano → Sfondo"/>
                        <ComboBoxItem Content="Primo piano → Trasparente"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel x:Name="OptShape" Orientation="Horizontal">
                    <TextBlock Text="Forma:" Style="{StaticResource OptLabel}"/>
                    <ComboBox x:Name="ShapeKind" Width="160" SelectedIndex="0">
                        <ComboBoxItem Content="Rettangolo"/>
                        <ComboBoxItem Content="Rettangolo arrotondato"/>
                        <ComboBoxItem Content="Ellisse"/>
                        <ComboBoxItem Content="Linea"/>
                    </ComboBox>
                    <TextBlock Text="Stile:" Style="{StaticResource OptLabel}"/>
                    <ComboBox x:Name="ShapeStyle" Width="120" SelectedIndex="0">
                        <ComboBoxItem Content="Riempimento"/>
                        <ComboBoxItem Content="Contorno"/>
                    </ComboBox>
                    <TextBlock Text="Spessore:" Style="{StaticResource OptLabel}"/>
                    <Slider x:Name="ShapeStroke" Minimum="1" Maximum="100" Value="6" Width="90"/>
                    <TextBlock Style="{StaticResource OptValue}" Text="{Binding Value, ElementName=ShapeStroke, StringFormat={}{0:0} px}"/>
                </StackPanel>

                <StackPanel x:Name="OptText" Orientation="Horizontal">
                    <TextBlock Text="Font:" Style="{StaticResource OptLabel}"/>
                    <ComboBox x:Name="FontCombo" Width="190"/>
                    <TextBlock Text="Dimensione:" Style="{StaticResource OptLabel}"/>
                    <TextBox x:Name="TextSizeBox" Width="48" Height="24" Text="72"/>
                    <TextBlock Text="px" Style="{StaticResource OptValue}" MinWidth="0"/>
                    <CheckBox x:Name="TextBold" Content="Grassetto" Margin="12,0,0,0"/>
                    <CheckBox x:Name="TextItalic" Content="Corsivo" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel x:Name="OptCrop" Orientation="Horizontal">
                    <Button Content="✓  Applica" Margin="12,0,0,0" Padding="12,2" Tag="crop.apply" Click="OptAction_Click"/>
                    <Button Content="✕  Annulla" Margin="6,0,0,0" Padding="12,2" Tag="crop.cancel" Click="OptAction_Click"/>
                </StackPanel>

                <StackPanel x:Name="OptZoom" Orientation="Horizontal">
                    <Button Content="100%" Margin="12,0,0,0" Padding="10,2" Tag="view.actual" Click="OptAction_Click"/>
                    <Button Content="Adatta allo schermo" Margin="6,0,0,0" Padding="10,2" Tag="view.fit" Click="OptAction_Click"/>
                </StackPanel>

                <TextBlock x:Name="OptHint" Style="{StaticResource OptLabel}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="290" MinWidth="220" MaxWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbox -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,10">
                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border x:Name="SecondarySwatch" Width="23" Height="23" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    BorderBrush="#FFBBBBBB" BorderThickness="1" Cursor="Hand" ToolTip="Colore di sfondo"
                                    MouseLeftButtonDown="SecondarySwatch_Click"/>
                            <Border x:Name="PrimarySwatch" Width="23" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    BorderBrush="#FFBBBBBB" BorderThickness="1" Cursor="Hand" ToolTip="Colore di primo piano"
                                    MouseLeftButtonDown="PrimarySwatch_Click"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="11" Content="&#xE8AB;"
                                    ToolTip="Inverti colori (X)" Click="SwapColors_Click"/>
                            <Button Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="11" Content="&#xE72C;"
                                    ToolTip="Colori predefiniti (D)" Click="ResetColors_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ToolPanel" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Move" ToolTip="Sposta (V)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconFill}" Data="M10,0 L13.5,3.5 L11,3.5 L11,9 L16.5,9 L16.5,6.5 L20,10 L16.5,13.5 L16.5,11 L11,11 L11,16.5 L13.5,16.5 L10,20 L6.5,16.5 L9,16.5 L9,11 L3.5,11 L3.5,13.5 L0,10 L3.5,6.5 L3.5,9 L9,9 L9,3.5 L6.5,3.5 Z"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="RectSelect" ToolTip="Selezione rettangolare (M)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconStroke}" StrokeDashArray="2 1.5" Data="M2,4 H18 V16 H2 Z"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="EllipseSelect" ToolTip="Selezione ellittica (M)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconStroke}" StrokeDashArray="2 1.5" Data="M2,10 A8,6 0 1 1 18,10 A8,6 0 1 1 2,10 Z"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Lasso" ToolTip="Lazo (L)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconStroke}" Data="M10,3 C15,3 18,5.5 18,8.5 C18,11.5 14.5,13.5 10,13.5 C5.5,13.5 2,11.5 2,8.5 C2,5.5 5,3 10,3 Z M6,12.5 C4.5,14.5 5.5,17 8,17.5"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Wand" ToolTip="Bacchetta magica (W)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconFill}" Data="M2,17 L11,8 L12.5,9.5 L3.5,18.5 Z M14,1 L15,4 L18,5 L15,6 L14,9 L13,6 L10,5 L13,4 Z"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Crop" ToolTip="Taglierina (C)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconStroke}" StrokeThickness="2" Data="M5,1 V15 H19 M1,5 H15 V19"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Eyedropper" ToolTip="Contagocce (I)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconFill}" Data="M14.5,1.5 C15.5,0.5 17.5,0.5 18.5,1.5 C19.5,2.5 19.5,4.5 18.5,5.5 L16,8 L17,9 L15.5,10.5 L9.5,4.5 L11,3 L12,4 Z M9,6 L14,11 L6,19 L3,19.5 L1.5,19 L1,17 L1.5,14 Z"/>
                        </RadioButton>
                        <Border Height="1" Background="#FF464646" Margin="4,4"/>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Brush" ToolTip="Pennello (B)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconFill}" Data="M18,1 L19,2 L10.5,12 L8,9.5 Z M7,10.5 L9.5,13 C9.5,16.5 6.5,19 1,19 C3,17 2,11.5 7,10.5 Z"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Clone" ToolTip="Timbro clone (S) — Alt+clic per campionare" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconFill}" Data="M7.5,1 H12.5 V7 C12.5,8 13,9 15,10 L17,11 V14 H3 V11 L5,10 C7,9 7.5,8 7.5,7 Z M2,15.5 H18 V18.5 H2 Z"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Eraser" ToolTip="Gomma (E)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconStroke}" Data="M12,2 L19,9 L11,17 H6 L1,12 Z M6.5,7.5 L13.5,14.5 M11,17 H19"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Bucket" ToolTip="Secchiello (G)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconFill}" Data="M8,1 L9.5,2.5 L8.5,3.5 L16,11 L9,18 L1,10 Z M17,12 C17,12 19.5,15.5 19.5,17 A2.5,2.5 0 0 1 14.5,17 C14.5,15.5 17,12 17,12 Z"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Gradient" ToolTip="Sfumatura (G)" Checked="Tool_Checked">
                            <Rectangle Width="18" Height="13" Stroke="{StaticResource TextBrush}" StrokeThickness="1">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF111111" Offset="0"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Dodge" ToolTip="Scherma / Brucia (O)" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconStroke}" Data="M9,7 A5,5 0 1 1 19,7 A5,5 0 1 1 9,7 Z M10.5,10.5 L2,19"/>
                        </RadioButton>
                        <Border Height="1" Background="#FF464646" Margin="4,4"/>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Text" ToolTip="Testo (T)" Checked="Tool_Checked">
                            <TextBlock Text="T" FontFamily="Times New Roman" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,-2,0,0"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Shape" ToolTip="Forme (U)" Checked="Tool_Checked">
                            <Grid Width="18" Height="18">
                                <Rectangle Width="11" Height="11" Fill="{StaticResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Ellipse Width="11" Height="11" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Fill="{StaticResource PanelBg}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </RadioButton>
                        <Border Height="1" Background="#FF464646" Margin="4,4"/>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Hand" ToolTip="Mano (H) — oppure tieni premuto Spazio" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconStroke}" StrokeThickness="1.3" Data="M6,11 V4 A1.3,1.3 0 0 1 8.6,4 V10 M8.6,9 V2.5 A1.3,1.3 0 0 1 11.2,2.5 V9.5 M11.2,9.5 V3.5 A1.3,1.3 0 0 1 13.8,3.5 V10 M13.8,10 V6 A1.3,1.3 0 0 1 16.4,6 V12.5 C16.4,16.5 14,19 10.5,19 C7.5,19 6,17.5 4.5,15 L2.5,11.5 A1.3,1.3 0 0 1 4.8,10.3 L6,12"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolButton}" Tag="Zoom" ToolTip="Zoom (Z) — Alt+clic per ridurre" Checked="Tool_Checked">
                            <Path Style="{StaticResource IconStroke}" StrokeThickness="2" Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M12.8,12.8 L19,19"/>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Document area -->
            <Grid Grid.Column="1" Background="{StaticResource CanvasBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ItemsControl x:Name="TabStrip" Background="{StaticResource PanelHeaderBg}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tab" Background="#FF2A2A2A" BorderBrush="#FF1A1A1A" BorderThickness="0,0,1,0"
                                    Padding="12,5,6,5" MouseLeftButtonDown="Tab_MouseDown" MouseDown="Tab_MiddleDown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TabText" Text="{Binding DisplayTitle}" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                                    <Button Style="{StaticResource TabCloseButton}" Content="✕" Margin="8,0,0,0" Click="TabClose_Click"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="#FF3C3C3C"/>
                                    <Setter TargetName="TabText" Property="Foreground" Value="#FFFFFFFF"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="CanvasArea" Grid.Row="1" Background="Transparent" ClipToBounds="True"
                        Focusable="True" FocusVisualStyle="{x:Null}"
                        PreviewMouseDown="CanvasArea_PreviewMouseDown" MouseMove="CanvasArea_MouseMove"
                        MouseUp="CanvasArea_MouseUp" LostMouseCapture="CanvasArea_LostMouseCapture"
                        MouseEnter="CanvasArea_MouseEnter" MouseLeave="CanvasArea_MouseLeave"
                        PreviewMouseWheel="CanvasArea_PreviewMouseWheel">
                    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ScrollViewer.Resources>
                            <!-- The canvas hides the pointer for the brush circle: the scroll bars keep the normal arrow. -->
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Style>
                        </ScrollViewer.Resources>
                        <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="80">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>
                            <Rectangle x:Name="CheckerRect"/>
                            <Image x:Name="CanvasImage" Stretch="Fill"/>
                            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                                <Path x:Name="CropShade" Fill="#A0000000"/>
                                <Path x:Name="CropFrame" Stroke="White"/>
                                <Path x:Name="SelPathBlack" Stroke="Black"/>
                                <Path x:Name="SelPathWhite" Stroke="White" StrokeDashArray="4 4"/>
                                <Path x:Name="PreviewBlack" Stroke="Black"/>
                                <Path x:Name="PreviewWhite" Stroke="White" StrokeDashArray="4 4"/>
                                <Path x:Name="ShapePreview" Opacity="0.75"/>
                                <Ellipse x:Name="BrushCursorOuter" Stroke="#C0000000" Visibility="Collapsed"/>
                                <Ellipse x:Name="BrushCursor" Stroke="#E0FFFFFF" Visibility="Collapsed"/>
                                <Path x:Name="CloneMarker" Stroke="White" Data="M-7,0 H7 M0,-7 V7" Visibility="Collapsed">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CloneMarkerScale"/>
                                            <TranslateTransform x:Name="CloneMarkerPos"/>
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <StackPanel x:Name="WelcomePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="PhotoStudio" FontSize="40" FontWeight="Light" HorizontalAlignment="Center" Foreground="#FFE8E8E8"/>
                    <TextBlock Text="Trascina qui una foto o un file RAW (.CR2, .CR3, .NEF, .ARW, .DNG...) oppure inizia con:" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,8,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Nuovo documento..." Padding="18,7" Tag="file.new" Click="OptAction_Click"/>
                        <Button Content="Apri immagine..." Padding="18,7" Margin="10,0,0,0" Tag="file.open" Click="OptAction_Click"/>
                        <Button Content="Preselezione cartella..." Padding="18,7" Margin="10,0,0,0" Tag="file.cull" Click="OptAction_Click"/>
                        <Button Content="Incolla" Padding="18,7" Margin="10,0,0,0" Tag="edit.paste" Click="OptAction_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="2" Width="4" Background="{StaticResource DividerBrush}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Focusable="False"/>

            <!-- Right panels -->
            <Grid Grid.Column="3" Background="{StaticResource PanelBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="210" MinHeight="80"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ISTOGRAMMA" Style="{StaticResource PanelHeader}"/>
                <Border Grid.Row="1" Height="96" Margin="10,0,10,8" Background="{StaticResource InputBg}" BorderBrush="#FF3A3A3A" BorderThickness="1">
                    <Viewbox Stretch="Fill">
                        <Canvas Width="256" Height="100">
                            <Polygon x:Name="HistR" Fill="#90E0453E"/>
                            <Polygon x:Name="HistG" Fill="#9040C050"/>
                            <Polygon x:Name="HistB" Fill="#904A7FE8"/>
                            <Polyline x:Name="HistL" Stroke="#C0DDDDDD" StrokeThickness="0.8"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="LIVELLI" Style="{StaticResource PanelHeader}"/>
                </Border>
                <Grid Grid.Row="3" Margin="10,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="96"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="BlendCombo" DisplayMemberPath="Name" SelectedValuePath="Mode"
                              SelectedValue="{Binding SelectedItem.Blend, ElementName=LayersList}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="Opacità:" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" Margin="0,0,6,0"/>
                        <Slider x:Name="OpacitySlider" Width="58" Minimum="0" Maximum="100"
                                Value="{Binding SelectedItem.Opacity, ElementName=LayersList}"/>
                        <TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="4" Margin="6,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="#FF2B2B2B">
                    <ListBox x:Name="LayersList" SelectionChanged="LayersList_SelectionChanged" MouseDoubleClick="LayersList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource EyeToggle}" IsChecked="{Binding Visible}" ToolTip="{DynamicResource Loc.ToggleLayer}"/>
                                    <Border Grid.Column="1" MaxWidth="42" MaxHeight="42" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource CheckerSmall}" BorderBrush="#FF111111" BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6,4,8,6">
                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Porta avanti (Ctrl+])" Tag="layer.up" Click="OptAction_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Porta indietro (Ctrl+[)" Tag="layer.down" Click="OptAction_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Unisci sotto (Ctrl+E)" Tag="layer.merge" Click="OptAction_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplica livello (Ctrl+J)" Tag="layer.duplicate" Click="OptAction_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Nuovo livello (Shift+Ctrl+N)" Tag="layer.new" Click="OptAction_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Elimina livello" Tag="layer.delete" Click="OptAction_Click"/>
                </StackPanel>

                <GridSplitter Grid.Row="6" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource DividerBrush}" ResizeBehavior="PreviousAndNext" Focusable="False"/>
                <DockPanel Grid.Row="7">
                    <TextBlock DockPanel.Dock="Top" Text="CRONOLOGIA" Style="{StaticResource PanelHeader}"/>
                    <Border Margin="6,0,6,8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="#FF2B2B2B">
                        <ListBox x:Name="HistoryList" SelectionChanged="HistoryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="T" Text="{Binding Name}" Padding="6,4"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                            <Setter TargetName="T" Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ================= EDITING FOLDER (after "Preselezione") ================= -->
        <Border x:Name="BatchPanel" Grid.Row="3" Visibility="Collapsed" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="38" Margin="10,0,6,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Center"
                            ToolTip="Chiudi la cartella di modifica (le schede aperte restano aperte)" Click="BatchClose_Click"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Content="Copia impostazioni" Padding="10,2" Margin="0,0,6,0" Focusable="False" Tag="dev.copy" Click="OptAction_Click"
                                ToolTip="Copia le impostazioni di Camera Raw della foto aperta (Alt+Maiusc+C)"/>
                        <Button Content="Applica..." Padding="10,2" Margin="0,0,6,0" Focusable="False" Tag="dev.paste" Click="OptAction_Click"
                                ToolTip="Applica le impostazioni copiate o un preset alla foto aperta o a tutte le foto (Alt+Maiusc+V)"/>
                        <Button Content="☀ Luce auto" Padding="10,2" Margin="0,0,6,0" Focusable="False" Tag="dev.smartlight" Click="OptAction_Click"
                                ToolTip="Luce intelligente sulla foto aperta o su tutte le foto da salvare (Alt+Ctrl+L)"/>
                        <Button x:Name="BatchExportButton" Content="Esportazione..." Padding="10,2" Focusable="False" Tag="batch.export" Click="OptAction_Click"/>
                        <Border Width="1" Background="#FF484848" Margin="10,6,4,6"/>
                        <TextBlock Text="Salva in:" Style="{StaticResource OptLabel}"/>
                        <TextBox x:Name="BatchOutput" Width="220" Height="24" ToolTip="Cartella in cui vengono salvate le foto modificate"/>
                        <Button Content="Sfoglia..." Margin="6,0,0,0" Padding="10,2" Focusable="False" Click="BatchBrowse_Click"/>
                        <TextBlock Text="Formato:" Style="{StaticResource OptLabel}"/>
                        <ComboBox x:Name="BatchFormat" Width="74" SelectedIndex="0" SelectionChanged="BatchFormat_SelectionChanged">
                            <ComboBoxItem Content="JPEG"/>
                            <ComboBoxItem Content="TIFF"/>
                            <ComboBoxItem Content="PNG"/>
                        </ComboBox>
                        <StackPanel x:Name="BatchQualityPanel" Orientation="Horizontal">
                            <TextBlock Text="Qualità:" Style="{StaticResource OptLabel}"/>
                            <TextBox x:Name="BatchQuality" Width="36" Height="24" Text="92" ToolTip="Qualità JPEG (1-100)"/>
                        </StackPanel>
                        <Border Width="1" Background="#FF484848" Margin="12,6,6,6"/>
                        <Button Content="◀" Padding="10,2" Focusable="False" ToolTip="Foto precedente" Tag="batch.prev" Click="OptAction_Click"/>
                        <Button Content="▶" Padding="10,2" Margin="4,0,0,0" Focusable="False" ToolTip="Foto successiva" Tag="batch.next" Click="OptAction_Click"/>
                        <Button x:Name="BatchSaveNextButton" Margin="8,0,0,0" Padding="12,2" Focusable="False"
                                Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                                Tag="batch.savenext" Click="OptAction_Click"
                                ToolTip="Salva la foto aperta nella cartella scelta, la chiude e apre la successiva (Ctrl+Invio)">
                            <TextBlock Text="Salva e passa alla successiva" FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                        <Button Content="Salva tutte le aperte" Margin="6,0,0,0" Padding="10,2" Focusable="False" Tag="batch.saveall" Click="OptAction_Click"
                                ToolTip="Salva nella cartella scelta tutte le foto di questa cartella aperte nelle schede"/>
                    </StackPanel>
                    <TextBlock x:Name="BatchTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ListBox x:Name="BatchList" Height="130" Margin="6,0,6,6" Background="#FF2B2B2B"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="BatchList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="112" Margin="0,4">
                                <Grid Height="70" Background="#FF1A1A1A">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <Border Height="2" Background="{Binding LabelBrush}"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RatingText}" FontSize="10" Foreground="#FFF2C94C"/>
                                    <TextBlock x:Name="St" Text="{Binding StateText}" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                </DockPanel>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Saved">
                                    <Setter TargetName="St" Property="Foreground" Value="#FF6CCB7A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Open">
                                    <Setter TargetName="St" Property="Foreground" Value="#FF7FB2F0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="4" Background="{StaticResource PanelHeaderBg}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Height="24">
            <DockPanel Margin="10,0">
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Left" Width="70" VerticalAlignment="Center"/>
                <TextBlock x:Name="SizeText" DockPanel.Dock="Left" Width="150" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock x:Name="PosText" DockPanel.Dock="Left" Width="140" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <Border x:Name="PixelSwatch" DockPanel.Dock="Left" Width="12" Height="12" BorderBrush="#FF777777" BorderThickness="1" Margin="0,0,6,0" Visibility="Hidden"/>
                <TextBlock x:Name="ColorText" DockPanel.Dock="Left" Width="200" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
